{
  "manifest_version": 3,
  "name": "Purdue automatic sign-in",
  "version": "1.0.4",
  "description": "Fill Purdue sign-in locally using your saved account and authenticator enrollment.",
  "permissions": ["storage", "activeTab"],
  "action": { "default_popup": "popup.html", "default_title": "Purdue automatic sign-in" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": [
      "https://sso.purdue.edu/*",
      "https://idp.purdue.edu/*",
      "https://login.microsoftonline.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
